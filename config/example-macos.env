# Run as the existing user: bash scripts/fluxenv --config config/example-macos.env
# This file is sourced as Bash; use only configuration files you trust.
INSTALL_HOMEBREW=1
ENABLE_VIM=1
CHANGE_DEFAULT_SHELL=ask
MACOS_EXTRA_FORMULAE=""
HF_LOGIN=ask
# HF_TOOL_SPEC="huggingface_hub>=1.20"
# FLUXENV_TOOL_BIN_DIR="$HOME/.local/bin"
# NVM_VERSION=0.39.7
# NODE_VERSION=24
# PNPM_VERSION=latest
# GITCODE_CLI_SPEC=atomgit-cli@latest
# NVM_DIR="$HOME/.nvm"
# PNPM_HOME="$HOME/.local/share/pnpm"

# Empty: ask on the first interactive run; reuse after initialization.
# Use --rename-device to ask again on an initialized Mac.
# An explicit name also authorizes renaming in --non-interactive mode.
DEVICE_NAME=""
LOCAL_HOST_NAME=""
# DEVICE_NAME="我的 MacBook"
# LOCAL_HOST_NAME="my-macbook"
SKIP_DEVICE_NAME=0
