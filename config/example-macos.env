# Run as the existing user: bash scripts/fluxenv --config config/example-macos.env
# This file is sourced as Bash; use only configuration files you trust.
INSTALL_HOMEBREW=1
ENABLE_VIM=1
CHANGE_DEFAULT_SHELL=ask
MACOS_EXTRA_FORMULAE=""

# Empty: ask on a terminal, keep the existing name in non-interactive runs.
# An explicit name also authorizes renaming in --non-interactive mode.
DEVICE_NAME=""
LOCAL_HOST_NAME=""
# DEVICE_NAME="我的 MacBook"
# LOCAL_HOST_NAME="my-macbook"
SKIP_DEVICE_NAME=0
