# FluxEnv override example

# HOST_NAME=myserver
# USER_NAME=winbeau
# USER_PASSWORD=change-me
# ENABLE_VIM=1
# ALLOW_ONLINE_FETCH=0
# 默认 ALLOW_ONLINE_FETCH=1：优先复用/离线资源，缺失时使用官方在线安装。
# HF_LOGIN=ask              # ask: 交互可选；0: 跳过；1: 终端中请求设备码登录
# HF_TOOL_SPEC="huggingface_hub>=1.20"
# FLUXENV_STATE_DIR=/var/lib/fluxenv
# FLUXENV_TOOL_BIN_DIR=/home/your-user/.local/bin
# ENABLE_APT_MIRROR=1
# APT_MIRROR_PRESET=tuna
# APT_UBUNTU_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
# APT_UBUNTU_PORTS_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
