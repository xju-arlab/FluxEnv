# macOS: tools are installed through Homebrew for the current user.
MACOS_FORMULAE="wget jq git autojump universal-ctags uv gh starship zsh-autosuggestions zsh-syntax-highlighting"
MACOS_EXTRA_FORMULAE=""
INSTALL_HOMEBREW=1
ENABLE_VIM=ask
ENABLE_NVIM=ask
ENABLE_DOCKER=ask
ENABLE_MACTEX=ask
NVIM_CONFIG_REPO="https://github.com/winbeau/Config-NeoVim.git"
CHANGE_DEFAULT_SHELL=ask
DEVICE_NAME=""
LOCAL_HOST_NAME=""
SKIP_DEVICE_NAME=0
HF_LOGIN=ask
HF_TOOL_SPEC="huggingface_hub>=1.20"
NVM_VERSION="0.39.7"
NODE_VERSION="24"
PNPM_VERSION="latest"
GITCODE_CLI_SPEC="atomgit-cli@latest"
