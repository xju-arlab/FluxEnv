# macOS: tools are installed through Homebrew for the current user.
MACOS_FORMULAE="wget jq git autojump universal-ctags uv starship zsh-autosuggestions zsh-syntax-highlighting"
MACOS_EXTRA_FORMULAE=""
INSTALL_HOMEBREW=1
ENABLE_VIM=ask
CHANGE_DEFAULT_SHELL=ask
DEVICE_NAME=""
LOCAL_HOST_NAME=""
SKIP_DEVICE_NAME=0
