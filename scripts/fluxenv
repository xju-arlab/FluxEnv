#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$(uname -s)" = "Darwin" ]; then
    exec /bin/bash "$ROOT_DIR/scripts/fluxenv-macos" "$@"
fi

source "$ROOT_DIR/lib/core.sh"
source "$ROOT_DIR/lib/config.sh"
source "$ROOT_DIR/lib/state.sh"
source "$ROOT_DIR/lib/managed.sh"
source "$ROOT_DIR/lib/user_tools.sh"

for module in "$ROOT_DIR"/lib/steps/*.sh; do
    # shellcheck source=/dev/null
    source "$module"
done

init_colors

usage() {
    cat <<'EOF'
Usage: scripts/fluxenv [options]

Options:
  --profile <name>       Built-in profile: standard, normal, autodl, macos
  --config <path>        Optional .env config overrides
  --non-interactive      Disable prompts; require config values up front
  --dry-run              Print planned mutations without executing them
  --no-apt-mirror        Do not replace apt sources with the configured mirror
  --hf-login            Offer Hugging Face browser/device-code login
  --skip-hf-login       Skip the optional Hugging Face login
  --status              Show saved initialization status without installing
  --history             Show initialization history without installing
  --state-dir <path>    Override the history root (absolute path)
  --help                 Show this help
EOF
}

PROFILE="normal"
CONFIG_FILE=""
INTERACTIVE=1
DRY_RUN=0
NO_APT_MIRROR=0
cli_hf_login=""
cli_state_dir=""
show_state=""

require_value() {
    [ "$#" -ge 2 ] && [ -n "$2" ] && [[ "$2" != -* ]] || die "$1 需要参数值"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --profile)
            require_value "$@"
            PROFILE="${2:-}"
            shift 2
            ;;
        --config)
            require_value "$@"
            CONFIG_FILE="${2:-}"
            shift 2
            ;;
        --non-interactive)
            INTERACTIVE=0
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            INTERACTIVE=0
            shift
            ;;
        --no-apt-mirror)
            NO_APT_MIRROR=1
            shift
            ;;
        --hf-login) cli_hf_login=1; shift ;;
        --skip-hf-login) cli_hf_login=0; shift ;;
        --status) show_state=status; shift ;;
        --history) show_state=history; shift ;;
        --state-dir)
            require_value "$@"
            cli_state_dir="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            die "Unknown argument: $1"
            ;;
    esac
done

if [ "$PROFILE" = "macos" ]; then
    die "macos profile 仅支持 macOS；Linux 请使用 normal、standard 或 autodl"
fi

load_defaults "$ROOT_DIR"
load_profile "$PROFILE"

if [ -n "$CONFIG_FILE" ]; then
    load_env_file "$CONFIG_FILE"
fi

if [ "$NO_APT_MIRROR" -eq 1 ]; then
    ENABLE_APT_MIRROR=0
fi

finalize_config
[ -z "$cli_hf_login" ] || HF_LOGIN="$cli_hf_login"
[ -z "$cli_state_dir" ] || FLUXENV_STATE_DIR="$cli_state_dir"
state_open "$FLUXENV_STATE_DIR" "$PROFILE_NAME"
if [ -n "$show_state" ]; then
    state_show "$show_state"
    exit 0
fi
[ -t 0 ] || INTERACTIVE=0
validate_user_tools_config
UV_BIN=""
HF_BIN=""
UV_TOOL_BIN=""

TOTAL_STAGES="$(word_count "$PROFILE_STEPS")"
CURRENT_STAGE=0

for step_name in $PROFILE_STEPS; do
    STATE_CURRENT_RESOURCE="stage/$step_name"
    "step_${step_name}"
    if [ "$step_name" = preflight ]; then
        state_begin
    fi
done
