#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$(uname -s)" = "Darwin" ]; then
    exec /bin/bash "$ROOT_DIR/scripts/fluxenv-macos" "$@"
fi

source "$ROOT_DIR/lib/core.sh"
source "$ROOT_DIR/lib/config.sh"

for module in "$ROOT_DIR"/lib/steps/*.sh; do
    # shellcheck source=/dev/null
    source "$module"
done

init_colors

usage() {
    cat <<'EOF'
Usage: scripts/fluxenv [options]

Options:
  --profile <name>       Built-in profile: standard, normal, autodl, macos
  --config <path>        Optional .env config overrides
  --non-interactive      Disable prompts; require config values up front
  --dry-run              Print planned mutations without executing them
  --no-apt-mirror        Do not replace apt sources with the configured mirror
  --help                 Show this help
EOF
}

PROFILE="normal"
CONFIG_FILE=""
INTERACTIVE=1
DRY_RUN=0
NO_APT_MIRROR=0

while [ $# -gt 0 ]; do
    case "$1" in
        --profile)
            PROFILE="${2:-}"
            shift 2
            ;;
        --config)
            CONFIG_FILE="${2:-}"
            shift 2
            ;;
        --non-interactive)
            INTERACTIVE=0
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            INTERACTIVE=0
            shift
            ;;
        --no-apt-mirror)
            NO_APT_MIRROR=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            die "Unknown argument: $1"
            ;;
    esac
done

if [ "$PROFILE" = "macos" ]; then
    die "macos profile 仅支持 macOS；Linux 请使用 normal、standard 或 autodl"
fi

load_defaults "$ROOT_DIR"
load_profile "$PROFILE"

if [ -n "$CONFIG_FILE" ]; then
    load_env_file "$CONFIG_FILE"
fi

if [ "$NO_APT_MIRROR" -eq 1 ]; then
    ENABLE_APT_MIRROR=0
fi

finalize_config

TOTAL_STAGES="$(word_count "$PROFILE_STEPS")"
CURRENT_STAGE=0

for step_name in $PROFILE_STEPS; do
    "step_${step_name}"
done
